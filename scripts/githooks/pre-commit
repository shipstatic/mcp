#!/bin/sh
# Platform-standard pre-commit (byte-identical across ShipStatic repos).
# Fast gate only — the full suite lives in CI.

# No platform credential may enter history. All THREE minted populations are
# scanned — `ship-` keys, `deploy-` tokens, and `claim-` codes, which became
# scannable the day they gained a prefix: a bare hex claim code was
# indistinguishable from a checksum, so no scanner could ever have caught one.
#
# The width is a FLOOR, not the current number. Credentials are 32 hex today
# and were 64 before; pinning either would make this guard blind to half the
# population it exists to catch, which is exactly what pinning {64} did. A
# leaked secret is worth over-matching for.
#
# Test and example paths are excluded — fixtures hold fake keys by design — as
# is the repeating fake test key.
LEAKS=$(git diff --cached --no-color --unified=0 --diff-filter=ACMR -- . \
  ':(exclude)**/tests/**' ':(exclude)**/__tests__/**' ':(exclude)**/*.test.*' \
  ':(exclude)test-utils/**' ':(exclude)examples/**' ':(exclude)e2e/**' \
  | grep -E '^\+' | grep -E '(ship|deploy|claim)-[0-9a-f]{32,}' \
  | grep -v '1234567890abcdef' || true)
if [ -n "$LEAKS" ]; then
  echo "credential detected in staged changes:" >&2
  echo "$LEAKS" >&2
  exit 1
fi

pnpm exec biome check --staged --no-errors-on-unmatched || exit 1

# Typecheck when the repo defines it — cheap; CI runs the superset.
if node -e "process.exit(require('./package.json').scripts?.typecheck ? 0 : 1)" 2>/dev/null; then
  pnpm typecheck
fi
