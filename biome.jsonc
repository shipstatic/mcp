// Platform-standard Biome config (one tool for lint + format; exact-pinned
// version so formatting never drifts between repos). Keep this file identical
// across ShipStatic repos; per-repo deviations get a comment explaining why.
{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // SVGs are image assets, not markup to lint.
    "includes": ["**", "!**/*.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Visible in editors and CI summaries without blocking the build.
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      // Tests may use `!`, `any`, ANSI-strip regexes, shared exported
      // helpers, and terse iteration freely — they assert the invariants
      // production code must prove.
      "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "complexity": { "noBannedTypes": "off" },
          "suspicious": {
            "noExplicitAny": "off",
            "noControlCharactersInRegex": "off",
            "noExportsInTest": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
